import Toybox.Lang;

// Generated by scripts/gen-i18n.py from i18n/spa.json.
// Do not edit: change those files and run python3 scripts/gen-i18n.py.
//
// A text's key is its table's number times TABLE_KEYS plus its index in the table, so a lookup knows
// which table to load (I18n.mc). Only the glance table's keys and resources are glance-annotated: the
// glance can load no other table.
(:glance)
module I18n {
    // The languages, in the order of the tables in tableId.
    enum Language {
        SPA
    }

    const LANGUAGE_COUNT = 1;
    const TABLE_KEYS = 256;

    // Table 0: "glance" in i18n/<lang>.json.
    enum {
        GlanceTitle = 0,
        GlanceCount = 1
    }

    // The glance table of a language.
    function glanceTable(language as Language) as ResourceId {
        var ids = [Rez.JsonData.GlanceSpa] as Array<ResourceId>;
        return ids[language as Number];
    }
}

// The other tables, which only the full-screen widget loads.
module I18n {
    const TABLE_COUNT = 3;

    // Table 1: "ui" in i18n/<lang>.json.
    enum {
        GroupsTitle = 256,
        GroupHolySpirit = 257,
        GroupPsalms = 258,
        GroupMarian = 259,
        GroupClassic = 260,
        TextPending = 261
    }

    // Table 2: "titles" in i18n/<lang>.json.
    enum {
        TitleComeHolySpirit = 512,
        TitleVeniCreator = 513,
        TitleSequence = 514,
        TitlePsalm23 = 515,
        TitlePsalm27 = 516,
        TitlePsalm51 = 517,
        TitleMagnificat = 518,
        TitleAngelus = 519,
        TitleAnimaChristi = 520,
        TitleSaintFrancis = 521,
        TitleNadaTeTurbe = 522,
        TitleAbandonment = 523,
        TitleSaintMichael = 524
    }

    // The resource of a table (0..TABLE_COUNT - 1) in a language: every language's tables in turn.
    function tableId(table as Number, language as Language) as ResourceId {
        var ids = [
            Rez.JsonData.GlanceSpa,
            Rez.JsonData.UiSpa,
            Rez.JsonData.TitlesSpa
        ] as Array<ResourceId>;
        return ids[(language as Number) * TABLE_COUNT + table];
    }
}
