import Toybox.Lang;

// Generated by scripts/gen-i18n.py from i18n/spa.json.
// Do not edit: change those files and run python3 scripts/gen-i18n.py.
//
// A text's key is its table's number times TABLE_KEYS plus its index in the table, so a lookup knows
// which table to load (I18n.mc). Only the glance table's keys and resources are glance-annotated: the
// glance can load no other table.
(:glance)
module I18n {
    // The languages, in the order of the tables in tableId.
    enum Language {
        SPA
    }

    const LANGUAGE_COUNT = 1;
    const TABLE_KEYS = 256;

    // Table 0: "glance" in i18n/<lang>.json.
    enum {
        GlanceTitle = 0,
        GlanceCount = 1,
        TitleOurFatherSpa = 2,
        TitleOurFatherLat = 3,
        TitleOurFatherEng = 4,
        TitleHailMarySpa = 5,
        TitleHailMaryLat = 6,
        TitleHailMaryEng = 7,
        TitleComeHolySpirit = 8,
        TitleSequence = 9,
        TitlePsalm23 = 10,
        TitlePsalm27 = 11,
        TitlePsalm51 = 12,
        TitleMagnificat = 13,
        TitleAngelus = 14,
        TitleAnimaChristi = 15,
        TitleSaintFrancis = 16,
        TitleNadaTeTurbe = 17,
        TitleAbandonment = 18,
        TitleSaintMichael = 19
    }

    // The glance table of a language.
    function glanceTable(language as Language) as ResourceId {
        var ids = [Rez.JsonData.GlanceSpa] as Array<ResourceId>;
        return ids[language as Number];
    }
}

// The other tables, which only the full-screen widget loads.
module I18n {
    const TABLE_COUNT = 20;

    // Table 1: "ui" in i18n/<lang>.json.
    enum {
        GroupsTitle = 256,
        GroupBasic = 257,
        GroupHolySpirit = 258,
        GroupPsalms = 259,
        GroupMarian = 260,
        GroupClassic = 261
    }

    // Table 2: "textOurFatherSpa" in i18n/<lang>.json.
    enum {
        TextOurFatherSpa = 512
    }

    // Table 3: "textOurFatherLat" in i18n/<lang>.json.
    enum {
        TextOurFatherLat = 768
    }

    // Table 4: "textOurFatherEng" in i18n/<lang>.json.
    enum {
        TextOurFatherEng = 1024
    }

    // Table 5: "textHailMarySpa" in i18n/<lang>.json.
    enum {
        TextHailMarySpa = 1280
    }

    // Table 6: "textHailMaryLat" in i18n/<lang>.json.
    enum {
        TextHailMaryLat = 1536
    }

    // Table 7: "textHailMaryEng" in i18n/<lang>.json.
    enum {
        TextHailMaryEng = 1792
    }

    // Table 8: "textComeHolySpirit" in i18n/<lang>.json.
    enum {
        TextComeHolySpirit = 2048
    }

    // Table 9: "textSequence" in i18n/<lang>.json.
    enum {
        TextSequence = 2304
    }

    // Table 10: "textPsalm23" in i18n/<lang>.json.
    enum {
        TextPsalm23 = 2560
    }

    // Table 11: "textPsalm27" in i18n/<lang>.json.
    enum {
        TextPsalm27 = 2816
    }

    // Table 12: "textPsalm51" in i18n/<lang>.json.
    enum {
        TextPsalm51 = 3072
    }

    // Table 13: "textMagnificat" in i18n/<lang>.json.
    enum {
        TextMagnificat = 3328
    }

    // Table 14: "textAngelus" in i18n/<lang>.json.
    enum {
        TextAngelus = 3584
    }

    // Table 15: "textAnimaChristi" in i18n/<lang>.json.
    enum {
        TextAnimaChristi = 3840
    }

    // Table 16: "textSaintFrancis" in i18n/<lang>.json.
    enum {
        TextSaintFrancis = 4096
    }

    // Table 17: "textNadaTeTurbe" in i18n/<lang>.json.
    enum {
        TextNadaTeTurbe = 4352
    }

    // Table 18: "textAbandonment" in i18n/<lang>.json.
    enum {
        TextAbandonment = 4608
    }

    // Table 19: "textSaintMichael" in i18n/<lang>.json.
    enum {
        TextSaintMichael = 4864
    }

    // The resource of a table (0..TABLE_COUNT - 1) in a language: every language's tables in turn.
    function tableId(table as Number, language as Language) as ResourceId {
        var ids = [
            Rez.JsonData.GlanceSpa,
            Rez.JsonData.UiSpa,
            Rez.JsonData.TextOurFatherSpaSpa,
            Rez.JsonData.TextOurFatherLatSpa,
            Rez.JsonData.TextOurFatherEngSpa,
            Rez.JsonData.TextHailMarySpaSpa,
            Rez.JsonData.TextHailMaryLatSpa,
            Rez.JsonData.TextHailMaryEngSpa,
            Rez.JsonData.TextComeHolySpiritSpa,
            Rez.JsonData.TextSequenceSpa,
            Rez.JsonData.TextPsalm23Spa,
            Rez.JsonData.TextPsalm27Spa,
            Rez.JsonData.TextPsalm51Spa,
            Rez.JsonData.TextMagnificatSpa,
            Rez.JsonData.TextAngelusSpa,
            Rez.JsonData.TextAnimaChristiSpa,
            Rez.JsonData.TextSaintFrancisSpa,
            Rez.JsonData.TextNadaTeTurbeSpa,
            Rez.JsonData.TextAbandonmentSpa,
            Rez.JsonData.TextSaintMichaelSpa
        ] as Array<ResourceId>;
        return ids[(language as Number) * TABLE_COUNT + table];
    }
}
