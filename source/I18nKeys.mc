import Toybox.Lang;

// Generated by scripts/gen-i18n.py from i18n/spa.json.
// Do not edit: change those files and run python3 scripts/gen-i18n.py.
//
// A text's key is its table's number times TABLE_KEYS plus its index in the table, so a lookup knows
// which table to load (I18n.mc). Only the glance table's keys and resources are glance-annotated: the
// glance can load no other table.
(:glance)
module I18n {
    // The languages, in the order of the tables in tableId.
    enum Language {
        SPA
    }

    const LANGUAGE_COUNT = 1;
    const TABLE_KEYS = 256;

    // Table 0: "glance" in i18n/<lang>.json.
    enum {
        GlanceTitle = 0,
        GlanceCount = 1,
        TitleOurFatherSpa = 2,
        TitleOurFatherLat = 3,
        TitleOurFatherEng = 4,
        TitleHailMarySpa = 5,
        TitleHailMaryLat = 6,
        TitleHailMaryEng = 7,
        TitleComeHolySpirit = 8,
        TitleSequence = 9,
        TitlePsalm16 = 10,
        TitlePsalm23 = 11,
        TitlePsalm27 = 12,
        TitlePsalm51 = 13,
        TitlePsalm84 = 14,
        TitlePsalm136 = 15,
        TitleBeatitudes = 16,
        TitleHymnOfLove = 17,
        TitleJohnPrologue = 18,
        TitleMagnificat = 19,
        TitleAngelus = 20,
        TitleBlessedPurity = 21,
        TitleConsecration = 22,
        TitleSpiritualCommunion = 23,
        TitleAdoroTe = 24,
        TitleDailyOffering = 25,
        TitleContrition = 26,
        TitleNightPrayer = 27,
        TitleAnimaChristi = 28,
        TitleSaintFrancis = 29,
        TitleNadaTeTurbe = 30,
        TitleAbandonment = 31,
        TitleSaintMichael = 32
    }

    // The glance table of a language.
    function glanceTable(language as Language) as ResourceId {
        var ids = [Rez.JsonData.GlanceSpa] as Array<ResourceId>;
        return ids[language as Number];
    }
}

