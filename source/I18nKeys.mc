import Toybox.Lang;

// Generated by scripts/gen-i18n.py from i18n/spa.json.
// Do not edit: change those files and run python3 scripts/gen-i18n.py.
//
// A text's key is its table's number times TABLE_KEYS plus its index in the table, so a lookup knows
// which table to load (I18n.mc). Only the glance table's keys and resources are glance-annotated: the
// glance can load no other table.
(:glance)
module I18n {
    // The languages, in the order of the tables in tableId.
    enum Language {
        SPA
    }

    const LANGUAGE_COUNT = 1;
    const TABLE_KEYS = 256;

    // Table 0: "glance" in i18n/<lang>.json.
    enum {
        GlanceTitle = 0,
        GlanceCount = 1,
        TitleComeHolySpirit = 2,
        TitleSequence = 3,
        TitlePsalm23 = 4,
        TitlePsalm27 = 5,
        TitlePsalm51 = 6,
        TitleMagnificat = 7,
        TitleAngelus = 8,
        TitleAnimaChristi = 9,
        TitleSaintFrancis = 10,
        TitleNadaTeTurbe = 11,
        TitleAbandonment = 12,
        TitleSaintMichael = 13
    }

    // The glance table of a language.
    function glanceTable(language as Language) as ResourceId {
        var ids = [Rez.JsonData.GlanceSpa] as Array<ResourceId>;
        return ids[language as Number];
    }
}

// The other tables, which only the full-screen widget loads.
module I18n {
    const TABLE_COUNT = 14;

    // Table 1: "ui" in i18n/<lang>.json.
    enum {
        GroupsTitle = 256,
        GroupHolySpirit = 257,
        GroupPsalms = 258,
        GroupMarian = 259,
        GroupClassic = 260
    }

    // Table 2: "textComeHolySpirit" in i18n/<lang>.json.
    enum {
        TextComeHolySpirit = 512
    }

    // Table 3: "textSequence" in i18n/<lang>.json.
    enum {
        TextSequence = 768
    }

    // Table 4: "textPsalm23" in i18n/<lang>.json.
    enum {
        TextPsalm23 = 1024
    }

    // Table 5: "textPsalm27" in i18n/<lang>.json.
    enum {
        TextPsalm27 = 1280
    }

    // Table 6: "textPsalm51" in i18n/<lang>.json.
    enum {
        TextPsalm51 = 1536
    }

    // Table 7: "textMagnificat" in i18n/<lang>.json.
    enum {
        TextMagnificat = 1792
    }

    // Table 8: "textAngelus" in i18n/<lang>.json.
    enum {
        TextAngelus = 2048
    }

    // Table 9: "textAnimaChristi" in i18n/<lang>.json.
    enum {
        TextAnimaChristi = 2304
    }

    // Table 10: "textSaintFrancis" in i18n/<lang>.json.
    enum {
        TextSaintFrancis = 2560
    }

    // Table 11: "textNadaTeTurbe" in i18n/<lang>.json.
    enum {
        TextNadaTeTurbe = 2816
    }

    // Table 12: "textAbandonment" in i18n/<lang>.json.
    enum {
        TextAbandonment = 3072
    }

    // Table 13: "textSaintMichael" in i18n/<lang>.json.
    enum {
        TextSaintMichael = 3328
    }

    // The resource of a table (0..TABLE_COUNT - 1) in a language: every language's tables in turn.
    function tableId(table as Number, language as Language) as ResourceId {
        var ids = [
            Rez.JsonData.GlanceSpa,
            Rez.JsonData.UiSpa,
            Rez.JsonData.TextComeHolySpiritSpa,
            Rez.JsonData.TextSequenceSpa,
            Rez.JsonData.TextPsalm23Spa,
            Rez.JsonData.TextPsalm27Spa,
            Rez.JsonData.TextPsalm51Spa,
            Rez.JsonData.TextMagnificatSpa,
            Rez.JsonData.TextAngelusSpa,
            Rez.JsonData.TextAnimaChristiSpa,
            Rez.JsonData.TextSaintFrancisSpa,
            Rez.JsonData.TextNadaTeTurbeSpa,
            Rez.JsonData.TextAbandonmentSpa,
            Rez.JsonData.TextSaintMichaelSpa
        ] as Array<ResourceId>;
        return ids[(language as Number) * TABLE_COUNT + table];
    }
}
